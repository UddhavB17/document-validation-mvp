DATABASE_URL=sqlite:///data/dmef.db
CHECKLIST_JSON_PATH=data/checklist.json
UPLOAD_DIR=data/uploads
PAGE_OUTPUT_DIR=data/pages
REPORT_OUTPUT_DIR=data/reports
API_BASE_URL=http://localhost:8000
LOCAL_LLM_API_URL=http://localhost:11434/api/generate
LOCAL_LLM_MODEL=llama3.1
OPEN_SOURCE_LLM_API_URL=

# Optional: local LLM page classification for Unknown / low-confidence scanned pages
ENABLE_LLM_PAGE_CLASSIFIER=false
LLM_CLASSIFIER_MIN_CONFIDENCE=0.75
LLM_CLASSIFIER_OCR_THRESHOLD=0.65
LLM_CLASSIFIER_MAX_PAGES_PER_FILE=100

# Optional: LLM-written anomaly summary after validation (requires Ollama running)
ENABLE_LLM_SUMMARY=false

# PaddleOCR runtime (disable oneDNN to avoid CPU inference crashes)
FLAGS_use_mkldnn=0
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

# OCR languages: dual mode runs Hindi (Devanagari+English) and English models
PADDLE_OCR_DUAL_LANG=true
PADDLE_OCR_LANG=hi

# Phase 2: enable field/date accuracy checks (PAN match, loan amount, bank vintage)
ENABLE_ACCURACY_CHECKS=true
