DATABASE_PATH=data/dmef.db
# Legacy alias still accepted by services/paths.py if DATABASE_PATH is unset:
# DATABASE_URL=sqlite:///data/dmef.db
CHECKLIST_JSON_PATH=data/checklist.json
UPLOAD_DIR=data/uploads
PAGE_OUTPUT_DIR=data/processed
REPORT_OUTPUT_DIR=data/reports
API_BASE_URL=http://localhost:8000
# Default is full pipeline (PP-StructureV3 escalate + optional LLMs).
# Opt-in only for ~8GB laptops: DMEF_LOW_MEMORY=true or scripts/start_mvp.sh
DMEF_LOW_MEMORY=false
DMEF_CONFIG_PROFILE=balanced
DMEF_PIPELINE_WORKERS=1
MAX_UPLOAD_SIZE_MB=300
# ZIP intake limits apply before documents are normalized into an internal PDF.
MAX_ZIP_EXTRACTED_SIZE_MB=500
MAX_ZIP_FILES=200
MAX_ZIP_PAGES=1000
MAX_XLSX_ROWS_PER_SHEET=10000
MAX_XLSX_COLUMNS_PER_SHEET=50
# Default OCRs every scanned page. Set DMEF_FULL_SCAN_OCR=false and
# DMEF_MAX_SCANNED_OCR_PAGES=30 to sample large packets for faster runs.
DMEF_MAX_SCANNED_OCR_PAGES=30
DMEF_FULL_SCAN_OCR=true
DMEF_RENDER_SCALE=1.0
DMEF_MAX_IMAGE_SIDE_PX=1600
DMEF_PROGRESS_UPDATE_EVERY=25
# LLM provider switch.
# Use `auto` to use an API key when present, otherwise local Ollama.
# Use `ollama` to force local development.
# Use `openai` for OpenAI, or `openai_compatible` for any /chat/completions-compatible API.
# Use `none` to disable shared LLM calls.
LLM_PROVIDER=auto

# API-key LLM placeholders. To switch later, set:
# With LLM_PROVIDER=auto, filling LLM_API_KEY is enough to use the API path.
# You can also force it with LLM_PROVIDER=openai.
# LLM_API_KEY=your_api_key_here
# LLM_MODEL=gpt-5.6-luna
# LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# Local Ollama settings. These remain the default when LLM_PROVIDER=ollama.
LOCAL_LLM_API_URL=http://localhost:11434/api/generate
LOCAL_LLM_MODEL=llama3.2:3b
OPEN_SOURCE_LLM_API_URL=

# Optional: local LLM page classification for Unknown / low-confidence scanned pages
ENABLE_LLM_PAGE_CLASSIFIER=true
LLM_CLASSIFIER_OCR_THRESHOLD=0.65
LLM_CLASSIFIER_MAX_PAGES_PER_FILE=100

# Optional: second-pass Ollama signal from extracted structured fields. It only
# runs for Unknown pages or pages below LLM_CLASSIFIER_OCR_THRESHOLD.
# Deterministic classification still wins; disagreements are logged for review.
ENABLE_STRUCTURED_LLM_CLASSIFIER=true
OLLAMA_CLASSIFIER_URL=http://192.168.31.225:11434
OLLAMA_CLASSIFIER_USE_LOCAL=true
LOCAL_OLLAMA_CLASSIFIER_URL=http://localhost:11434
OLLAMA_CLASSIFIER_MODEL=llama3.2:3b
OLLAMA_CLASSIFIER_TIMEOUT_SECONDS=3

# Optional: LLM-written anomaly summary after validation (requires Ollama running)
ENABLE_LLM_SUMMARY=true

# Optional: LLM fallback for low-confidence fuzzy field verification
ENABLE_LLM_FIELD_VERIFIER=true
LLM_FIELD_VERIFIER_MODEL=qwen2.5:7b

# Optional: LLM fallback for suspicious OCR JSON field assignment
ENABLE_LLM_FIELD_ASSIGNMENT=true
LLM_FIELD_ASSIGNMENT_MODEL=qwen2.5:7b-instruct-q4_0

# API-first OCR. Scanned pages use Google Vision once; digital PDFs use their
# embedded text and do not incur an OCR request.
OCR_PROVIDER=google_vision
GOOGLE_VISION_MAX_ATTEMPTS=3
# Optional comma-separated BCP-47 hints such as en,gu. Leave empty to let
# DOCUMENT_TEXT_DETECTION auto-detect all supported languages on each page.
GOOGLE_VISION_LANGUAGE_HINTS=
GOOGLE_VISION_AUTH=auto
# Optional. Prefer Settings UI for the API key; blank env values are ignored.
# GOOGLE_VISION_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_VISION_FEATURE=DOCUMENT_TEXT_DETECTION
GOOGLE_VISION_TIMEOUT_SECONDS=60
GOOGLE_VISION_API_ENDPOINT=
GOOGLE_VISION_REST_URL=https://vision.googleapis.com/v1/images:annotate

# Secure recovery controls. In production, provide a Fernet key through the
# environment/secret manager and a high-entropy API control token. When the
# encryption key is omitted locally, a mode-0600 key is generated under data/.
DMEF_JOB_INPUT_KEY=
DMEF_JOB_CONTROL_TOKEN=
DMEF_JOB_HEARTBEAT_GRACE_SECONDS=180

# Phase 2: enable field/date accuracy checks (PAN match, loan amount, bank vintage)
ENABLE_ACCURACY_CHECKS=true

# Validation profile overrides (profile defaults are fast/balanced/strict)
MIN_CLASSIFICATION_CONFIDENCE=0.60
MIN_SCANNED_OCR_CONFIDENCE=0.70
MIN_CHECKLIST_MATCHES_FOR_LOAN_FILE=2
MAX_UNKNOWN_RATIO_FOR_UNSUPPORTED_FILE=0.60
PAGE_PROCESSING_FAILURE_THRESHOLD=2

# OCR guardrails
OCR_SOFT_TIMEOUT_SECONDS=60
OCR_HARD_TIMEOUT_SECONDS=180
