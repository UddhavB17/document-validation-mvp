.DS_Store
.venv/
.venv311/
.codex-venv/
.pytest_cache/
__pycache__/
*.pyc
node_modules/
.next/
tsconfig.tsbuildinfo
.env
.env.*
!.env.example

# Never commit real/sensitive documents or generated processing outputs.
uploads/*
outputs/*
data/uploads/*
data/pages/*
data/reports/*
data/store/*
data/dmef.db
data/*.db
data/*.db.bak
data/dmef.db-*
data/*.db*-shm
data/*.db*-wal
data/.job_input.key
database.db
data/database.db
data/paddlex_cache/*
data/processed/*
data/surya_cache/*
*.pdf
*.jpg
*.jpeg
*.png

# Keep repo documentation images explicitly allowed.
!docs/*.png

# Keep empty folders.
!uploads/.gitkeep
!outputs/.gitkeep
!data/.gitkeep
!data/uploads/.gitkeep
!data/pages/.gitkeep
!data/reports/.gitkeep
!data/processed/.gitkeep

# Logs
data/logs/*
*.log
