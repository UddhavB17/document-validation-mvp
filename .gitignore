.DS_Store
.venv/
__pycache__/
*.pyc
.env
.env.*
!.env.example

# Never commit real/sensitive documents or generated processing outputs.
uploads/*
outputs/*
data/uploads/*
data/pages/*
data/reports/*
data/dmef.db
data/paddlex_cache/*
*.pdf
*.jpg
*.jpeg
*.png

# Keep repo documentation images explicitly allowed.
!docs/*.png

# Keep empty folders.
!uploads/.gitkeep
!outputs/.gitkeep
!data/.gitkeep
!data/uploads/.gitkeep
!data/pages/.gitkeep
!data/reports/.gitkeep
